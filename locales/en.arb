  "lesson_20_hint_0": "Top: <code>CONSTRUCT &#123; ?stay :inForest ?forest &#125;</code>",
  "@lesson_20_hint_0": {
    "description": "Lesson 20 «CONSTRUCT»: hint 1",
    "context": "html"
  },
  "lesson_20_hint_1": "WHERE: <code>?stay :atSpot ?spot . ?spot :liesWithin+ ?forest . ?forest a :Forest .</code>",
  "@lesson_20_hint_1": {
    "description": "Lesson 20 «CONSTRUCT»: hint 2",
