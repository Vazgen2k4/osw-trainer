  "lesson_27_starter": "@prefix rml:  <http://w3id.org/rml/> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .\n@prefix bv:   <https://kbss.fel.cvut.cz/bivak#> .\n@prefix :     <https://kbss.fel.cvut.cz/bivak/mapping#> .\n\n:Sample a rml:TriplesMap ;\n    rml:logicalSource [\n        rml:source \"mzchu-sample.csv\" ;\n        rml:referenceFormulation rml:CSV ] ;\n    rml:subjectMap [ rml:template \"https://kbss.fel.cvut.cz/bivak#MZCHU_{KOD}\" ] ;\n    rml:predicateObjectMap [\n        rml:predicate rdfs:label ;\n        rml:objectMap [ rml:reference \"NAZEV\" ; rml:language \"cs\" ] ] ;\n    # add more predicateObjectMap blocks (the last one ends with a full stop)\n    .\n",
