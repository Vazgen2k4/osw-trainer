  "lesson_8_term_0": "",
  "@lesson_8_term_0": {
    "description": "Lesson 8 «FILTER and lang()»: short explanation of the English term «FILTER» (may stay empty)"
  },
  "lesson_8_term_1": "",
  "@lesson_8_term_1": {
